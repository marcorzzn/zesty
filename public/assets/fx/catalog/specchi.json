{
  "category": "specchi",
  "effects": [
    {"id": "dist_mirror", "label": "Specchio", "params": [{"id": "mode", "label": "Lato", "type": "choice", "options": ["Sinistra", "Destra", "Alto", "Basso", "Quattro"], "default": 0}], "steps": [{"op": "mirror", "mode": {"pick": "$mode", "from": ["left", "right", "top", "bottom", "quad"]}}], "group": "Simmetrie e riflessioni"},
    {"id": "dist_flip", "label": "Capovolgi", "params": [{"id": "h", "label": "Orizzontale", "type": "toggle", "default": 1}, {"id": "v", "label": "Verticale", "type": "toggle", "default": 0}], "steps": [{"op": "flip", "horizontal": "$h", "vertical": "$v"}], "group": "Simmetrie e riflessioni"},
    {"id": "dist_kaleidoscope", "label": "Caleidoscopio", "params": [{"id": "segments", "label": "Spicchi", "min": 2, "max": 24, "default": 8}, {"id": "angle", "label": "Rotazione", "min": 0, "max": 360, "default": 0}], "steps": [{"op": "kaleidoscope", "segments": "$segments", "angle": "$angle"}], "group": "Caleidoscopi"},
    {"id": "dist_mandala", "label": "Mandala", "group": "Caleidoscopi", "params": [{"id": "rings", "label": "Anelli", "min": 2, "max": 12, "default": 5}, {"id": "symmetry", "label": "Simmetria", "min": 3, "max": 16, "default": 6}, {"id": "growth", "label": "Spicchi in più per anello", "min": 0, "max": 100, "default": 50}, {"id": "twist", "label": "Rotazione alternata", "min": 0, "max": 45, "default": 15}, {"id": "shadow", "label": "Ombra fra gli anelli", "min": 0, "max": 100, "default": 40}, {"id": "zoom", "label": "Zoom", "min": 30, "max": 200, "default": 100}, {"id": "cx", "label": "Centro, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro, verticale", "min": 0, "max": 100, "default": 50}], "steps": [{"op": "mandala", "rings": "$rings", "symmetry": "$symmetry", "growth": "$growth", "twist": "$twist", "shadow": "$shadow", "zoom": "$zoom", "cx": "$cx", "cy": "$cy", "radius": 48}], "tags": ["mandala", "rosone", "simmetria"]},
    {"id": "geo_tiles_hex", "label": "Piastrelle esagonali", "group": "Caleidoscopi", "params": [{"id": "size", "label": "Piastrelle", "min": 4, "max": 30, "default": 12, "step": 0.5}, {"id": "rotate", "label": "Rotazione", "min": 0, "max": 60, "default": 0}, {"id": "zoom", "label": "Zoom", "min": 30, "max": 250, "default": 100}, {"id": "cx", "label": "Soggetto, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Soggetto, verticale", "min": 0, "max": 100, "default": 50}, {"id": "relief", "label": "Rilievo", "min": 0, "max": 100, "default": 30}, {"id": "line", "label": "Fughe", "min": 0, "max": 1.5, "default": 0.3, "step": 0.05}, {"id": "lineColor", "label": "Colore fughe", "type": "color", "default": "#F4EFE6"}], "steps": [{"op": "tessellate", "size": "$size", "rotate": "$rotate", "zoom": "$zoom", "cx": "$cx", "cy": "$cy", "relief": "$relief", "line": "$line", "lineColor": "$lineColor", "mode": "hex"}], "tags": ["esagoni", "tassellazione", "caleidoscopio"]},
    {"id": "geo_tiles_tri", "label": "Tassellazione triangolare", "group": "Caleidoscopi", "params": [{"id": "size", "label": "Piastrelle", "min": 4, "max": 30, "default": 14, "step": 0.5}, {"id": "rotate", "label": "Rotazione", "min": 0, "max": 60, "default": 0}, {"id": "zoom", "label": "Zoom", "min": 30, "max": 250, "default": 100}, {"id": "cx", "label": "Soggetto, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Soggetto, verticale", "min": 0, "max": 100, "default": 50}, {"id": "relief", "label": "Rilievo", "min": 0, "max": 100, "default": 0}, {"id": "line", "label": "Fughe", "min": 0, "max": 1.5, "default": 0, "step": 0.05}], "steps": [{"op": "tessellate", "size": "$size", "rotate": "$rotate", "zoom": "$zoom", "cx": "$cx", "cy": "$cy", "relief": "$relief", "line": "$line", "mode": "triangle", "lineColor": "#FFFFFF"}], "tags": ["triangoli", "tassellazione"]},
    {"id": "geo_tiles_square", "label": "Piastrelle a specchio", "group": "Caleidoscopi", "params": [{"id": "size", "label": "Piastrelle", "min": 4, "max": 30, "default": 10, "step": 0.5}, {"id": "rotate", "label": "Rotazione", "min": 0, "max": 90, "default": 0}, {"id": "zoom", "label": "Zoom", "min": 30, "max": 250, "default": 100}, {"id": "cx", "label": "Soggetto, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Soggetto, verticale", "min": 0, "max": 100, "default": 50}, {"id": "relief", "label": "Rilievo", "min": 0, "max": 100, "default": 35}, {"id": "line", "label": "Fughe", "min": 0, "max": 1.5, "default": 0.25, "step": 0.05}, {"id": "lineColor", "label": "Colore fughe", "type": "color", "default": "#1A1A1A"}], "steps": [{"op": "tessellate", "size": "$size", "rotate": "$rotate", "zoom": "$zoom", "cx": "$cx", "cy": "$cy", "relief": "$relief", "line": "$line", "lineColor": "$lineColor", "mode": "square"}], "tags": ["piastrelle", "quadrati", "maiolica"]},
    {"id": "dist_droste", "label": "Ricorsione infinita", "group": "Infinito", "params": [{"id": "scale", "label": "Scala delle copie", "min": 20, "max": 80, "default": 45}, {"id": "rotate", "label": "Rotazione", "min": -45, "max": 45, "default": 8}, {"id": "cx", "label": "Centro, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro, verticale", "min": 0, "max": 100, "default": 50}, {"id": "frame", "label": "Cornice", "min": 0, "max": 2, "default": 0.6, "step": 0.1}, {"id": "frameColor", "label": "Colore cornice", "type": "color", "default": "#FFFFFF"}], "steps": [{"op": "droste", "scale": "$scale", "rotate": "$rotate", "cx": "$cx", "cy": "$cy", "frame": "$frame", "frameColor": "$frameColor"}], "tags": ["droste", "ricorsione"]},
    {"id": "dist_droste_spiral", "label": "Spirale infinita", "group": "Infinito", "params": [{"id": "scale", "label": "Passo", "min": 20, "max": 70, "default": 40}, {"id": "arms", "label": "Bracci", "min": 1, "max": 3, "default": 1}, {"id": "cx", "label": "Centro, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro, verticale", "min": 0, "max": 100, "default": 50}, {"id": "frame", "label": "Cornice", "min": 0, "max": 2, "default": 0.5, "step": 0.1}], "steps": [{"op": "droste", "mode": "spiral", "scale": "$scale", "arms": "$arms", "cx": "$cx", "cy": "$cy", "frame": "$frame"}], "tags": ["escher", "spirale"]},
    {"id": "dist_julia", "label": "Frattale di Julia", "group": "Frattali e iperbolici", "params": [{"id": "re", "label": "Costante, parte reale", "min": -100, "max": 100, "default": -80, "step": 0.5}, {"id": "im", "label": "Costante, parte immaginaria", "min": -100, "max": 100, "default": 15.6, "step": 0.5}, {"id": "iterations", "label": "Dettaglio", "min": 2, "max": 40, "default": 14}, {"id": "zoom", "label": "Zoom", "min": 40, "max": 300, "default": 100}, {"id": "rotate", "label": "Rotazione", "min": -180, "max": 180, "default": 0}, {"id": "shade", "label": "Ombre del frattale", "min": 0, "max": 100, "default": 40}, {"id": "cx", "label": "Centro, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro, verticale", "min": 0, "max": 100, "default": 50}], "steps": [{"op": "julia_warp", "re": "$re", "im": "$im", "iterations": "$iterations", "zoom": "$zoom", "rotate": "$rotate", "shade": "$shade", "cx": "$cx", "cy": "$cy"}], "tags": ["frattale", "julia"]},
    {"id": "dist_julia_rabbit", "label": "Riccioli frattali", "group": "Frattali e iperbolici", "params": [{"id": "re", "label": "Costante, parte reale", "min": -100, "max": 100, "default": -12.3, "step": 0.5}, {"id": "im", "label": "Costante, parte immaginaria", "min": -100, "max": 100, "default": 74.5, "step": 0.5}, {"id": "iterations", "label": "Dettaglio", "min": 2, "max": 40, "default": 14}, {"id": "zoom", "label": "Zoom", "min": 40, "max": 300, "default": 100}, {"id": "rotate", "label": "Rotazione", "min": -180, "max": 180, "default": 0}, {"id": "shade", "label": "Ombre del frattale", "min": 0, "max": 100, "default": 40}, {"id": "cx", "label": "Centro, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro, verticale", "min": 0, "max": 100, "default": 50}], "steps": [{"op": "julia_warp", "re": "$re", "im": "$im", "iterations": "$iterations", "zoom": "$zoom", "rotate": "$rotate", "shade": "$shade", "cx": "$cx", "cy": "$cy"}], "tags": ["frattale", "julia", "coniglio"]},
    {"id": "dist_poincare", "label": "Disco di Poincaré", "group": "Frattali e iperbolici", "params": [{"id": "p", "label": "Lati", "min": 3, "max": 10, "default": 6}, {"id": "q", "label": "Attorno a ogni vertice", "min": 3, "max": 10, "default": 4}, {"id": "zoom", "label": "Zoom", "min": 30, "max": 250, "default": 100}, {"id": "rotate", "label": "Rotazione", "min": -180, "max": 180, "default": 0}, {"id": "cx", "label": "Soggetto, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Soggetto, verticale", "min": 0, "max": 100, "default": 50}, {"id": "line", "label": "Lati in nero", "min": 0, "max": 1, "default": 0.2, "step": 0.05}, {"id": "alternate", "label": "Tessere alterne", "min": 0, "max": 100, "default": 15}, {"id": "background", "label": "Sfondo", "type": "color", "default": "#0E0E10"}], "steps": [{"op": "poincare", "p": "$p", "q": "$q", "zoom": "$zoom", "rotate": "$rotate", "cx": "$cx", "cy": "$cy", "line": "$line", "alternate": "$alternate", "background": "$background", "radius": 96, "depth": 30}], "tags": ["iperbolico", "escher", "poincare"]},
    {"id": "dist_poincare_rose", "label": "Rosone iperbolico", "group": "Frattali e iperbolici", "params": [{"id": "p", "label": "Lati", "min": 3, "max": 10, "default": 7}, {"id": "q", "label": "Attorno a ogni vertice", "min": 3, "max": 10, "default": 3}, {"id": "zoom", "label": "Zoom", "min": 30, "max": 250, "default": 120}, {"id": "rotate", "label": "Rotazione", "min": -180, "max": 180, "default": 0}, {"id": "cx", "label": "Soggetto, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Soggetto, verticale", "min": 0, "max": 100, "default": 50}, {"id": "line", "label": "Lati", "min": 0, "max": 1, "default": 0.12, "step": 0.05}, {"id": "lineColor", "label": "Colore lati", "type": "color", "default": "#E8C77A"}, {"id": "background", "label": "Sfondo", "type": "color", "default": "#0E0E10"}], "steps": [{"op": "poincare", "p": "$p", "q": "$q", "zoom": "$zoom", "rotate": "$rotate", "cx": "$cx", "cy": "$cy", "line": "$line", "lineColor": "$lineColor", "background": "$background", "radius": 96, "mirror": true, "alternate": 25, "depth": 35}], "tags": ["iperbolico", "rosone", "caleidoscopio"]},
    {"id": "dist_inversion", "label": "Inversione circolare", "group": "Frattali e iperbolici", "params": [{"id": "radius", "label": "Raggio", "min": 8, "max": 50, "default": 28}, {"id": "cx", "label": "Centro, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro, verticale", "min": 0, "max": 100, "default": 50}, {"id": "rotate", "label": "Rotazione", "min": -180, "max": 180, "default": 180}, {"id": "rim", "label": "Anello", "min": 0, "max": 2, "default": 0.4, "step": 0.05}, {"id": "rimColor", "label": "Colore anello", "type": "color", "default": "#FFFFFF"}], "steps": [{"op": "mobius", "radius": "$radius", "cx": "$cx", "cy": "$cy", "rotate": "$rotate", "rim": "$rim", "rimColor": "$rimColor", "mode": "inside"}], "tags": ["inversione", "mobius", "cerchio"]},
    {"id": "dist_tiny_planet", "label": "Piccolo pianeta", "params": [{"id": "rotate", "label": "Rotazione", "min": 0, "max": 360, "default": 0}, {"id": "zoom", "label": "Zoom", "min": 0.4, "max": 3, "default": 1, "step": 0.05}], "steps": [{"op": "polar", "rotate": "$rotate", "zoom": "$zoom"}], "group": "Proiezioni sferiche e 3D"},
    {"id": "dist_tunnel", "label": "Tunnel", "params": [{"id": "rotate", "label": "Rotazione", "min": 0, "max": 360, "default": 0}, {"id": "zoom", "label": "Zoom", "min": 0.4, "max": 3, "default": 1, "step": 0.05}], "steps": [{"op": "polar", "rotate": "$rotate", "zoom": "$zoom", "inverted": true}, {"op": "vignette", "amount": 60, "radius": 20, "softness": 60, "color": "#000000", "roundness": 100, "cx": 0.5, "cy": 0.5}], "group": "Proiezioni sferiche e 3D"},
    {"id": "dist_fisheye", "label": "Fisheye", "params": [{"id": "strength", "label": "Intensità", "default": 60}, {"id": "radius", "label": "Raggio", "min": 10, "max": 100, "default": 70}], "steps": [{"op": "bulge", "strength": "$strength", "radius": "$radius"}], "group": "Proiezioni sferiche e 3D"},
    {"id": "dist_crystal_ball", "label": "Bolla di cristallo", "group": "Proiezioni sferiche e 3D", "params": [{"id": "radius", "label": "Raggio", "min": 10, "max": 48, "default": 30}, {"id": "ior", "label": "Rifrazione", "min": 1.1, "max": 2.5, "default": 1.5, "step": 0.05}, {"id": "cx", "label": "Centro, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro, verticale", "min": 0, "max": 100, "default": 52}, {"id": "bgBlur", "label": "Sfondo sfocato", "min": 0, "max": 6, "default": 1.5, "step": 0.1}, {"id": "shine", "label": "Riflesso", "min": 0, "max": 100, "default": 60}], "steps": [{"op": "glass_sphere", "radius": "$radius", "ior": "$ior", "cx": "$cx", "cy": "$cy", "bgBlur": "$bgBlur", "shine": "$shine", "bgDark": 15}], "tags": ["sfera", "lensball", "cristallo"]},
    {"id": "dist_swirl", "label": "Vortice", "params": [{"id": "angle", "label": "Rotazione", "min": -720, "max": 720, "default": 220}, {"id": "radius", "label": "Raggio", "min": 5, "max": 100, "default": 50}, {"id": "cx", "label": "Centro X", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro Y", "min": 0, "max": 100, "default": 50}], "steps": [{"op": "swirl", "angle": "$angle", "radius": "$radius", "cx": "$cx / 100", "cy": "$cy / 100"}], "group": "Onde, vortici e fluidi"},
    {"id": "dist_waves", "label": "Onde", "params": [{"id": "amplitude", "label": "Ampiezza", "min": 0.1, "max": 6, "default": 1.2, "step": 0.1}, {"id": "wavelength", "label": "Lunghezza", "min": 2, "max": 50, "default": 12}, {"id": "mode", "label": "Direzione", "type": "choice", "options": ["Entrambe", "Orizzontale", "Verticale"], "default": 0}], "steps": [{"op": "ripple", "amplitude": "$amplitude", "wavelength": "$wavelength", "mode": {"pick": "$mode", "from": ["both", "horizontal", "vertical"]}}], "group": "Onde, vortici e fluidi"},
    {"id": "dist_water", "label": "Acqua", "params": [{"id": "amplitude", "label": "Ampiezza", "min": 0.1, "max": 5, "default": 1, "step": 0.1}, {"id": "wavelength", "label": "Onde", "min": 2, "max": 30, "default": 6}, {"id": "phase", "label": "Fase", "min": 0, "max": 360, "default": 0}, {"id": "cx", "label": "Centro X", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro Y", "min": 0, "max": 100, "default": 50}], "steps": [{"op": "ripple", "mode": "radial", "amplitude": "$amplitude", "wavelength": "$wavelength", "phase": "$phase", "cx": "$cx / 100", "cy": "$cy / 100"}], "group": "Onde, vortici e fluidi"},
    {"id": "dist_liquid", "label": "Liquido", "params": [{"id": "amount", "label": "Intensità", "min": 0.2, "max": 10, "default": 2.5, "step": 0.1}, {"id": "scale", "label": "Scala", "min": 2, "max": 50, "default": 15}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "turbulence", "amount": "$amount", "scale": "$scale"}], "group": "Onde, vortici e fluidi"},
    {"id": "dist_pinch", "label": "Pizzica", "params": [{"id": "strength", "label": "Intensità", "default": 60}, {"id": "radius", "label": "Raggio", "min": 10, "max": 100, "default": 60}], "steps": [{"op": "bulge", "strength": "-$strength", "radius": "$radius"}], "group": "Onde, vortici e fluidi"},
    {"id": "dist_caricature", "label": "Caricatura", "params": [{"id": "strength", "label": "Intensità", "default": 55}, {"id": "cx", "label": "Centro X", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro Y", "min": 0, "max": 100, "default": 40}, {"id": "radius", "label": "Raggio", "min": 10, "max": 80, "default": 35}], "steps": [{"op": "bulge", "strength": "$strength", "radius": "$radius", "cx": "$cx / 100", "cy": "$cy / 100"}], "group": "Onde, vortici e fluidi"},
    {"id": "dist_shear", "label": "Inclina", "params": [{"id": "x", "label": "Orizzontale", "min": -45, "max": 45, "default": 15}, {"id": "y", "label": "Verticale", "min": -45, "max": 45, "default": 0}], "steps": [{"op": "shear", "x": "$x", "y": "$y"}], "group": "Frammenti e geometrie"},
    {"id": "dist_disperse", "label": "Dispersione", "params": [{"id": "angle", "label": "Direzione", "min": 0, "max": 360, "default": 0}, {"id": "distance", "label": "Distanza", "min": 2, "max": 60, "default": 20}, {"id": "size", "label": "Frammenti", "min": 0.5, "max": 5, "default": 1.5, "step": 0.1}, {"id": "amount", "label": "Quantità", "default": 60}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "disperse", "angle": "$angle", "distance": "$distance", "size": "$size", "amount": "$amount"}], "group": "Frammenti e geometrie"},
    {"id": "dist_glass", "label": "Vetro smerigliato", "params": [{"id": "amount", "label": "Intensità", "min": 0.1, "max": 3, "default": 0.6, "step": 0.1}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "turbulence", "amount": "$amount", "scale": 0.5}, {"op": "adjust", "brightness": 5}], "group": "Frammenti e geometrie"},
    {"id": "dist_shatter", "label": "Vetro in frantumi", "group": "Frammenti e geometrie", "params": [{"id": "size", "label": "Primo anello", "min": 3, "max": 20, "default": 7, "step": 0.5}, {"id": "spokes", "label": "Crepe", "min": 8, "max": 48, "default": 22}, {"id": "amount", "label": "Spostamento", "min": 0, "max": 100, "default": 60}, {"id": "cx", "label": "Impatto, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Impatto, verticale", "min": 0, "max": 100, "default": 45}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "shatter", "size": "$size", "spokes": "$spokes", "amount": "$amount", "cx": "$cx", "cy": "$cy", "crack": 75}], "tags": ["vetro", "schegge"]},
    {"id": "geo_low_poly", "label": "Low-poly", "group": "Frammenti e geometrie", "params": [{"id": "size", "label": "Triangoli", "min": 2, "max": 15, "default": 5, "step": 0.5}, {"id": "facet", "label": "Sfaccettatura", "min": 0, "max": 60, "default": 22}, {"id": "wire", "label": "Filo", "min": 0, "max": 100, "default": 0}, {"id": "wireColor", "label": "Colore filo", "type": "color", "default": "#FFFFFF"}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "low_poly", "size": "$size", "facet": "$facet", "wire": "$wire", "wireColor": "$wireColor", "jitter": 75}, {"op": "adjust", "saturation": 10}], "tags": ["poligoni", "geometrico"]},
    {"id": "geo_blinds", "label": "Persiane", "group": "Frammenti e geometrie", "params": [{"id": "count", "label": "Lamelle", "min": 4, "max": 60, "default": 16}, {"id": "angle", "label": "Inclinazione", "min": -90, "max": 90, "default": 0}, {"id": "tilt", "label": "Spostamento", "min": 0, "max": 100, "default": 35}, {"id": "gap", "label": "Fessure", "min": 0, "max": 40, "default": 12}], "steps": [{"op": "blinds", "count": "$count", "angle": "$angle", "tilt": "$tilt", "gap": "$gap", "relief": 60}], "tags": ["lamelle", "strisce"]},
