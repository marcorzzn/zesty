{
  "category": "bn",
  "effects": [
    {"id": "bw_classic", "label": "Classico", "params": [{"id": "contrast", "label": "Contrasto", "min": -100, "max": 100, "default": 10}], "steps": [{"op": "mono"}, {"op": "adjust", "contrast": "$contrast"}]},
    {"id": "bw_high_contrast", "label": "Alto contrasto", "params": [{"id": "amount", "label": "Intensità", "default": 60}], "steps": [{"op": "mono", "r": 0.3, "g": 0.6, "b": 0.1}, {"op": "curves", "rgb": [[0, 0], [60, 30], [190, 225], [255, 255]]}, {"op": "adjust", "contrast": "$amount * 0.5"}]},
    {"id": "bw_soft", "label": "Morbido", "params": [{"id": "amount", "label": "Morbidezza", "default": 50}], "steps": [{"op": "mono"}, {"op": "curves", "rgb": [[0, "$amount * 0.6"], [128, 134], [255, "255 - $amount * 0.3"]]}, {"op": "layer", "steps": [{"op": "blur", "radius": 1.5}], "blend": "soft-light", "opacity": "$amount / 100"}]},
    {"id": "bw_red_filter", "label": "Filtro rosso", "params": [{"id": "amount", "label": "Intensità", "default": 70}], "steps": [{"op": "mono", "reds": "$amount * 0.8", "oranges": "$amount * 0.6", "yellows": "$amount * 0.3", "blues": "-$amount * 0.8", "cyans": "-$amount * 0.6"}, {"op": "adjust", "contrast": 15}]},
    {"id": "bw_green_filter", "label": "Filtro verde", "params": [{"id": "amount", "label": "Intensità", "default": 70}], "steps": [{"op": "mono", "greens": "$amount * 0.8", "yellows": "$amount * 0.4", "reds": "-$amount * 0.4", "magentas": "-$amount * 0.4"}, {"op": "adjust", "contrast": 10}]},
    {"id": "bw_blue_filter", "label": "Filtro blu", "params": [{"id": "amount", "label": "Intensità", "default": 70}], "steps": [{"op": "mono", "blues": "$amount * 0.8", "cyans": "$amount * 0.6", "reds": "-$amount * 0.6", "oranges": "-$amount * 0.4"}, {"op": "adjust", "contrast": 10}]},
    {"id": "bw_mixer", "label": "Miscelatore B&N", "params": [{"id": "reds", "label": "Rossi", "min": -100, "max": 100, "default": 0}, {"id": "oranges", "label": "Arancioni", "min": -100, "max": 100, "default": 0}, {"id": "yellows", "label": "Gialli", "min": -100, "max": 100, "default": 0}, {"id": "greens", "label": "Verdi", "min": -100, "max": 100, "default": 0}, {"id": "cyans", "label": "Ciano", "min": -100, "max": 100, "default": 0}, {"id": "blues", "label": "Blu", "min": -100, "max": 100, "default": 0}, {"id": "purples", "label": "Viola", "min": -100, "max": 100, "default": 0}, {"id": "magentas", "label": "Magenta", "min": -100, "max": 100, "default": 0}], "steps": [{"op": "mono", "reds": "$reds", "oranges": "$oranges", "yellows": "$yellows", "greens": "$greens", "cyans": "$cyans", "blues": "$blues", "purples": "$purples", "magentas": "$magentas"}]},
    {"id": "bw_film", "label": "Pellicola B&N", "params": [{"id": "grain", "label": "Grana", "default": 35}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "mono", "r": 0.35, "g": 0.55, "b": 0.1}, {"op": "curves", "rgb": [[0, 8], [70, 55], [185, 205], [255, 248]]}, {"op": "grain", "amount": "$grain", "size": 0.15}, {"op": "vignette", "amount": 25, "radius": 70}]},
    {"id": "bw_noir", "label": "Noir", "params": [{"id": "amount", "label": "Intensità", "default": 70}], "steps": [{"op": "mono"}, {"op": "curves", "rgb": [[0, 0], [70, "70 - $amount * 0.6"], [180, "180 + $amount * 0.5"], [255, 255]]}, {"op": "vignette", "amount": "$amount * 0.8", "radius": 45, "softness": 60}, {"op": "grain", "amount": 15}]},
    {"id": "bw_selenium", "label": "Selenio", "params": [{"id": "amount", "label": "Viraggio", "default": 45}], "steps": [{"op": "mono"}, {"op": "split_tone", "shadows": "#4a3a5a", "highlights": "#e8ddd0", "amount": "$amount"}]},
    {"id": "bw_sepia", "label": "Seppia", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#1e140c"], [0.5, "#8a6a48"], [1, "#f6ead6"]], "opacity": "$amount / 100"}]},
    {"id": "bw_platinum", "label": "Platino", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#151312"], [0.5, "#7d7468"], [1, "#f2ede4"]], "opacity": "$amount / 100"}, {"op": "curves", "rgb": [[0, 12], [128, 132], [255, 246]]}]},
    {"id": "bw_hdr", "label": "B&N HDR", "params": [{"id": "amount", "label": "Intensità", "default": 70}], "steps": [{"op": "mono"}, {"op": "clarity", "amount": "$amount * 1.3", "radius": 4}, {"op": "clarity", "amount": "$amount * 0.6", "radius": 12}, {"op": "sharpen", "amount": "$amount", "radius": 0.3}]},
    {"id": "bw_glow", "label": "B&N luminoso", "params": [{"id": "amount", "label": "Bagliore", "default": 50}], "steps": [{"op": "mono"}, {"op": "layer", "steps": [{"op": "blur", "radius": 2.5}], "blend": "screen", "opacity": "$amount / 100"}, {"op": "adjust", "contrast": 20}]},
    {"id": "bw_infrared", "label": "Infrarosso", "params": [{"id": "amount", "label": "Intensità", "default": 80}], "steps": [{"op": "mono", "greens": "$amount", "yellows": "$amount * 0.6", "blues": "-$amount * 0.6", "reds": "$amount * 0.2"}, {"op": "glow", "threshold": 55, "radius": 2, "strength": 60}, {"op": "grain", "amount": 25}]},
    {"id": "bw_threshold", "label": "Soglia", "params": [{"id": "level", "label": "Livello", "min": 0, "max": 255, "default": 128}, {"id": "softness", "label": "Morbidezza", "min": 0, "max": 60, "default": 6}], "steps": [{"op": "threshold", "level": "$level", "softness": "$softness"}]},
    {"id": "bw_deep", "label": "Neri profondi", "params": [{"id": "amount", "label": "Intensità", "default": 50}], "steps": [{"op": "mono"}, {"op": "levels", "inBlack": "$amount * 0.8", "gamma": 0.95}]},
    {"id": "bw_matte", "label": "Opaco", "params": [{"id": "amount", "label": "Opacità", "default": 50}], "steps": [{"op": "mono"}, {"op": "adjust", "fade": "$amount", "contrast": -10}]},
    {"id": "bw_crossed", "label": "Contrasto incrociato", "params": [{"id": "amount", "label": "Intensità", "default": 60}], "steps": [{"op": "mono", "r": 0.5, "g": 0.4, "b": 0.1}, {"op": "curves", "rgb": [[0, 0], [80, "80 - $amount * 0.5"], [170, "170 + $amount * 0.5"], [255, 255]]}, {"op": "split_tone", "shadows": "#20304a", "highlights": "#f0efe8", "amount": 20}]},
    {"id": "bw_charcoal_tone", "label": "Grafite", "params": [{"id": "amount", "label": "Intensità", "default": 70}], "steps": [{"op": "gradient_map", "stops": [[0, "#0e1012"], [0.6, "#5d6268"], [1, "#e4e6e8"]]}, {"op": "clarity", "amount": "$amount * 0.6", "radius": 3}, {"op": "texture", "kind": "paper", "amount": 30, "blend": "overlay"}]}
  ]
}
