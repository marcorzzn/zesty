{
  "category": "colore",
  "effects": [
    {"id": "color_splash", "label": "Color splash", "params": [{"id": "hue", "label": "Tinta da tenere", "min": 0, "max": 360, "default": 0}, {"id": "range", "label": "Ampiezza", "min": 5, "max": 90, "default": 25}, {"id": "softness", "label": "Sfumatura", "min": 1, "max": 60, "default": 15}, {"id": "outside", "label": "Colore residuo", "default": 0}], "steps": [{"op": "color_keep", "hue": "$hue", "range": "$range", "softness": "$softness", "outside": "$outside"}]},
    {"id": "color_splash_multi", "label": "Splash multiplo", "params": [{"id": "hue1", "label": "Tinta 1", "min": 0, "max": 360, "default": 0}, {"id": "hue2", "label": "Tinta 2", "min": 0, "max": 360, "default": 120}, {"id": "hue3", "label": "Tinta 3", "min": 0, "max": 360, "default": 220}, {"id": "range", "label": "Ampiezza", "min": 5, "max": 60, "default": 18}], "steps": [{"op": "color_keep", "hues": ["$hue1", "$hue2", "$hue3"], "range": "$range", "softness": 12}]},
    {"id": "color_splash_inverse", "label": "Splash inverso", "params": [{"id": "hue", "label": "Tinta da togliere", "min": 0, "max": 360, "default": 210}, {"id": "range", "label": "Ampiezza", "min": 5, "max": 90, "default": 30}], "steps": [{"op": "color_keep", "hue": "$hue", "range": "$range", "softness": 15, "invert": true}]},
    {"id": "color_replace", "label": "Sostituisci colore", "params": [{"id": "from", "label": "Da tinta", "min": 0, "max": 360, "default": 0}, {"id": "to", "label": "A tinta", "min": 0, "max": 360, "default": 210}, {"id": "range", "label": "Ampiezza", "min": 5, "max": 90, "default": 30}, {"id": "softness", "label": "Sfumatura", "min": 1, "max": 60, "default": 20}, {"id": "saturation", "label": "Saturazione", "min": -100, "max": 100, "default": 0}], "steps": [{"op": "hue_replace", "from": "$from", "to": "$to", "range": "$range", "softness": "$softness", "saturation": "$saturation"}]},
    {"id": "hue_rotate", "label": "Rotazione tinta", "params": [{"id": "hue", "label": "Tinta", "min": -180, "max": 180, "default": 60}], "steps": [{"op": "adjust", "hue": "$hue"}]},
    {"id": "saturation", "label": "Saturazione", "params": [{"id": "amount", "label": "Saturazione", "min": -100, "max": 100, "default": 40}], "steps": [{"op": "adjust", "saturation": "$amount"}]},
    {"id": "colorize", "label": "Colora", "params": [{"id": "color", "label": "Colore", "type": "color", "default": "#ff6a3d"}, {"id": "amount", "label": "Intensità", "default": 70}], "steps": [{"op": "tint", "color": "$color", "amount": "$amount"}]},
    {"id": "mono_tint", "label": "Monocromo colorato", "params": [{"id": "color", "label": "Colore", "type": "color", "default": "#3d8bff"}], "steps": [{"op": "gradient_map", "stops": [[0, "#000000"], [0.5, "$color"], [1, "#ffffff"]]}]},
    {"id": "duotone", "label": "Bicromia", "params": [{"id": "dark", "label": "Scuri", "type": "color", "default": "#1a1446"}, {"id": "light", "label": "Chiari", "type": "color", "default": "#ffcf5a"}, {"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "duotone", "dark": "$dark", "light": "$light", "opacity": "$amount / 100"}]},
    {"id": "tritone", "label": "Tricromia", "params": [{"id": "dark", "label": "Scuri", "type": "color", "default": "#14213d"}, {"id": "mid", "label": "Medi", "type": "color", "default": "#e63946"}, {"id": "light", "label": "Chiari", "type": "color", "default": "#f1faee"}, {"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "$dark"], [0.5, "$mid"], [1, "$light"]], "opacity": "$amount / 100"}]},
    {"id": "gmap_sunset", "label": "Mappa Tramonto", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#2b0f3a"], [0.35, "#c2185b"], [0.7, "#ff9800"], [1, "#ffe8a3"]], "opacity": "$amount / 100"}]},
    {"id": "gmap_ocean", "label": "Mappa Oceano", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#03142b"], [0.4, "#0b5ea8"], [0.75, "#4fd1c5"], [1, "#e6fffb"]], "opacity": "$amount / 100"}]},
    {"id": "gmap_fire", "label": "Mappa Fuoco", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#120200"], [0.35, "#8a1200"], [0.65, "#ff6a00"], [1, "#fff1a8"]], "opacity": "$amount / 100"}]},
    {"id": "gmap_aurora", "label": "Mappa Aurora", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#061a28"], [0.4, "#0f7b6c"], [0.75, "#7ae582"], [1, "#f0ffc9"]], "opacity": "$amount / 100"}]},
    {"id": "gmap_lavender", "label": "Mappa Lavanda", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#1d1433"], [0.5, "#8e7cc3"], [1, "#f6f0ff"]], "opacity": "$amount / 100"}]},
    {"id": "gmap_cyber", "label": "Mappa Cyber", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#0d0221"], [0.35, "#7b2cbf"], [0.7, "#ff2a6d"], [1, "#05d9e8"]], "opacity": "$amount / 100"}]},
    {"id": "gmap_gold", "label": "Mappa Oro", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#1a1205"], [0.4, "#7a5517"], [0.75, "#d4a537"], [1, "#fff4c7"]], "opacity": "$amount / 100"}]},
    {"id": "gmap_mint", "label": "Mappa Menta", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#0b2e2a"], [0.5, "#3fb59a"], [1, "#eafff6"]], "opacity": "$amount / 100"}]},
    {"id": "gmap_peach", "label": "Mappa Pesca", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#3a1520"], [0.5, "#f08a6c"], [1, "#fff0e0"]], "opacity": "$amount / 100"}]},
    {"id": "gmap_night", "label": "Mappa Notte", "params": [{"id": "amount", "label": "Intensità", "default": 100}], "steps": [{"op": "gradient_map", "stops": [[0, "#000008"], [0.45, "#18204a"], [0.8, "#5a7ac8"], [1, "#e0ecff"]], "opacity": "$amount / 100"}]},
    {"id": "color_balance", "label": "Bilanciamento colore", "params": [{"id": "shadows", "label": "Colore ombre", "type": "color", "default": "#2060a0"}, {"id": "highlights", "label": "Colore luci", "type": "color", "default": "#f0a040"}, {"id": "balance", "label": "Bilanciamento", "min": -100, "max": 100, "default": 0}, {"id": "amount", "label": "Intensità", "default": 50}], "steps": [{"op": "split_tone", "shadows": "$shadows", "highlights": "$highlights", "balance": "$balance", "amount": "$amount"}]},
    {"id": "channels_brg", "label": "Canali scambiati", "params": [{"id": "order", "label": "Ordine", "type": "choice", "options": ["BRG", "GBR", "RBG", "BGR", "GRB"], "default": 0}], "steps": [{"op": "channel_swap", "order": {"pick": "$order", "from": ["brg", "gbr", "rbg", "bgr", "grb"]}}]},
    {"id": "invert", "label": "Inverti", "params": [], "steps": [{"op": "invert"}]},
    {"id": "solarize", "label": "Solarizza", "params": [{"id": "threshold", "label": "Soglia", "min": 0, "max": 255, "default": 128}], "steps": [{"op": "solarize", "threshold": "$threshold"}]},
    {"id": "posterize", "label": "Posterizza", "params": [{"id": "levels", "label": "Livelli", "min": 2, "max": 16, "default": 5}], "steps": [{"op": "posterize", "levels": "$levels"}]},
    {"id": "warm", "label": "Caldo", "params": [{"id": "amount", "label": "Intensità", "default": 40}], "steps": [{"op": "adjust", "temperature": "$amount", "vibrance": "$amount * 0.2"}]},
    {"id": "cool", "label": "Freddo", "params": [{"id": "amount", "label": "Intensità", "default": 40}], "steps": [{"op": "adjust", "temperature": "-$amount", "tint": "-$amount * 0.1"}]},
    {"id": "pastel", "label": "Pastello", "params": [{"id": "amount", "label": "Intensità", "default": 60}], "steps": [{"op": "adjust", "saturation": "-$amount * 0.35", "fade": "$amount * 0.4", "brightness": "$amount * 0.15", "contrast": "-$amount * 0.15"}]},
    {"id": "vivid", "label": "Vivido", "params": [{"id": "amount", "label": "Intensità", "default": 60}], "steps": [{"op": "adjust", "vibrance": "$amount * 0.7", "saturation": "$amount * 0.3", "contrast": "$amount * 0.15"}]},
    {"id": "curve_s", "label": "Curva a S", "params": [{"id": "amount", "label": "Intensità", "default": 50}], "steps": [{"op": "curves", "rgb": [[0, 0], [64, "64 - $amount * 0.3"], [192, "192 + $amount * 0.3"], [255, 255]]}]},
    {"id": "gradient_overlay", "label": "Sfumatura colore", "params": [{"id": "color1", "label": "Colore 1", "type": "color", "default": "#ff3d7f"}, {"id": "color2", "label": "Colore 2", "type": "color", "default": "#3d8bff"}, {"id": "angle", "label": "Angolo", "min": 0, "max": 360, "default": 45}, {"id": "amount", "label": "Intensità", "default": 60}], "steps": [{"op": "gradient", "type": "linear", "angle": "$angle", "stops": [[0, "$color1"], [1, "$color2"]], "blend": "soft-light", "opacity": "$amount / 100"}]},
    {"id": "color_tone_lift", "label": "Toni sollevati", "params": [{"id": "color", "label": "Colore", "type": "color", "default": "#3a2a6a"}, {"id": "amount", "label": "Intensità", "default": 40}], "steps": [{"op": "fill", "color": "$color", "blend": "lighten", "opacity": "$amount / 100"}]}
  ]
}
