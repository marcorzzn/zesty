{
  "category": "arte",
  "effects": [
    {"id": "art_egypt", "label": "Pittura murale egizia", "group": "Arte antica", "params": [{"id": "amount", "label": "Intensità", "default": 85}, {"id": "aged", "label": "Invecchiamento", "default": 50}], "steps": [{"op": "flat_regions", "levels": 4, "passes": 4, "saturation": 10}, {"op": "gradient_map", "stops": [[0, "#1a1410"], [0.3, "#a2452a"], [0.55, "#c88a3a"], [0.8, "#d9c18e"], [1, "#efe2c0"]], "opacity": 0.85}, {"op": "adjust", "saturation": 25, "contrast": 10}, {"op": "edges", "mode": "overlay", "strength": 70, "threshold": 12}, {"op": "texture", "kind": "concrete", "amount": "$aged * 0.4", "blend": "multiply"}], "tags": ["egitto", "affresco"]},
    {"id": "art_fresco", "label": "Affresco", "group": "Arte antica", "params": [{"id": "amount", "label": "Intensità", "default": 80}, {"id": "aged", "label": "Polvere", "default": 45}], "steps": [{"op": "adjust", "saturation": -25, "contrast": -15, "brightness": 8}, {"op": "split_tone", "shadows": "#3a4a8a", "highlights": "#e8c8a0", "amount": 40}, {"op": "oil", "radius": 0.5}, {"op": "texture", "kind": "concrete", "amount": "$aged * 0.5", "blend": "multiply"}], "tags": ["giotto", "tempera"]},
    {"id": "art_relief", "label": "Bassorilievo", "group": "Arte antica", "params": [{"id": "amount", "label": "Profondità", "default": 70}, {"id": "mat", "label": "Materiale", "type": "choice", "options": ["Marmo", "Pietra", "Bronzo"], "default": 0}], "steps": [{"op": "emboss", "strength": "$amount", "depth": 0.4}, {"op": "gradient_map", "stops": [[0, {"pick": "$mat", "from": ["#8a8a86", "#6a5f52", "#3a2410"]}], [1, {"pick": "$mat", "from": ["#f4f2ec", "#d6cbb6", "#d8a04a"]}]]}], "tags": ["scultura", "rilievo"]},
    {"id": "art_marble", "label": "Scultura in marmo", "group": "Arte antica", "params": [{"id": "amount", "label": "Intensità", "default": 80}], "steps": [{"op": "mono"}, {"op": "adjust", "brightness": 15, "contrast": -10}, {"op": "texture", "kind": "marble", "amount": 18, "blend": "multiply"}, {"op": "emboss", "strength": 25, "blend": "overlay"}], "tags": ["scultura", "marmo"]},
    {"id": "art_byzantine", "label": "Mosaico bizantino", "group": "Arte antica", "params": [{"id": "size", "label": "Tessere", "min": 0.8, "max": 4, "default": 1.6}], "steps": [{"op": "crystallize", "size": "$size"}, {"op": "adjust", "saturation": 20}, {"op": "tint", "color": "#e6b84a", "amount": 20, "mask": {"type": "luma", "from": 60, "to": 100}}], "tags": ["mosaico", "oro"]},
    {"id": "art_miniature", "label": "Miniatura medievale", "group": "Arte antica", "params": [{"id": "amount", "label": "Intensità", "default": 80}], "steps": [{"op": "smooth", "radius": 1.2}, {"op": "palette_quantize", "colors": 9, "tone": 0}, {"op": "adjust", "saturation": 30}, {"op": "edges", "mode": "overlay", "strength": 55, "threshold": 12}, {"op": "mat", "size": 5, "color": "#efe0b8", "line": 0.6, "lineColor": "#c49a3a"}], "tags": ["medioevo", "pergamena"]},
    {"id": "art_etching", "label": "Acquaforte", "group": "Arte antica", "params": [{"id": "amount", "label": "Intensità", "default": 90}, {"id": "line", "label": "Segno", "min": 0.35, "max": 1.2, "default": 0.5}, {"id": "wave", "label": "Volume", "min": 0, "max": 14, "default": 8}], "steps": [{"op": "engrave", "size": "$line", "wave": "$wave", "angle": 20, "contrast": 20, "ink": "#2a1a10", "paper": "#efe4cc"}, {"op": "hatching", "size": "$line * 1.3", "layers": 2, "angle": -30, "contrast": 30, "ink": "#2a1a10", "paper": "#efe4cc", "blend": "multiply", "opacity": 0.5}, {"op": "vignette", "amount": 25, "radius": 75}], "tags": ["incisione", "rembrandt"]},
    {"id": "art_bit80", "label": "Bit anni '80", "group": "Pixel e retro", "params": [{"id": "px", "label": "Pixel", "min": 0.3, "max": 3, "default": 0.8}, {"id": "pal", "label": "Palette", "type": "choice", "options": ["Rosso e blu", "1 bit", "Verde fosforo"], "default": 0}], "steps": [{"op": "pixelate", "size": "$px"}, {"op": "dither", "mode": "bayer", "size": "$px * 0.5", "mono": true}, {"op": "gradient_map", "stops": [[0, "#050505"], [0.5, {"pick": "$pal", "from": ["#e01e1e", "#050505", "#0f6b2a"]}], [1, {"pick": "$pal", "from": ["#1e3cff", "#f2f2f2", "#7dff7a"]}]]}], "tags": ["pixel art", "8 bit", "amiga"]},
    {"id": "draw_pencil", "label": "Matita", "params": [{"id": "radius", "label": "Tratto", "min": 0.3, "max": 3, "default": 1, "step": 0.1}, {"id": "darkness", "label": "Intensità", "default": 50}], "steps": [{"op": "sketch", "radius": "$radius", "darkness": "$darkness"}], "group": "Tecniche di disegno"},
    {"id": "draw_color_pencil", "label": "Matite colorate", "params": [{"id": "radius", "label": "Tratto", "min": 0.3, "max": 3, "default": 1, "step": 0.1}, {"id": "darkness", "label": "Intensità", "default": 45}], "steps": [{"op": "adjust", "saturation": 30}, {"op": "sketch", "radius": "$radius", "darkness": "$darkness", "colored": true}], "group": "Tecniche di disegno"},
    {"id": "draw_charcoal", "label": "Carboncino", "params": [{"id": "amount", "label": "Intensità", "default": 70}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "sketch", "radius": 2, "darkness": "$amount"}, {"op": "adjust", "contrast": 25}, {"op": "texture", "kind": "paper", "scale": 0.6, "amount": 60, "blend": "multiply"}], "group": "Tecniche di disegno"},
    {"id": "draw_color_contours", "label": "Contorni colorati", "params": [{"id": "strength", "label": "Intensità", "min": 30, "max": 300, "default": 140}], "steps": [{"op": "adjust", "saturation": 40}, {"op": "edges", "mode": "color", "strength": "$strength", "smooth": 0.2}], "group": "Tecniche di disegno"},
    {"id": "draw_neon_edges", "label": "Contorni neon", "params": [{"id": "strength", "label": "Intensità", "min": 50, "max": 300, "default": 180}, {"id": "glow", "label": "Bagliore", "default": 70}], "steps": [{"op": "adjust", "saturation": 80}, {"op": "edges", "mode": "glow", "keepColor": true, "strength": "$strength", "smooth": 0.3}, {"op": "glow", "threshold": 15, "radius": 1.5, "strength": "$glow"}], "group": "Tecniche di disegno"},
    {"id": "draw_watercolor", "label": "Acquerello", "params": [{"id": "amount", "label": "Intensità", "default": 70}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "smooth", "radius": 2, "strength": 70}, {"op": "oil", "radius": "0.5 + $amount * 0.012"}, {"op": "turbulence", "amount": 0.4, "scale": 4}, {"op": "adjust", "saturation": 15, "brightness": 8}, {"op": "edges", "mode": "overlay", "strength": 60, "smooth": 0.6, "opacity": 0.5}, {"op": "texture", "kind": "paper", "scale": 0.8, "amount": 45, "blend": "multiply"}], "group": "Tecniche di disegno"},
    {"id": "draw_oil", "label": "Pittura a olio", "params": [{"id": "amount", "label": "Pennellata", "min": 0.3, "max": 4, "default": 1.4, "step": 0.1}], "steps": [{"op": "oil", "radius": "$amount"}, {"op": "adjust", "saturation": 15}, {"op": "texture", "kind": "canvas", "scale": 0.4, "amount": 35, "blend": "overlay"}, {"op": "sharpen", "amount": 50, "radius": 0.3}], "group": "Tecniche di disegno"},
    {"id": "draw_impasto", "label": "Impasto", "params": [{"id": "amount", "label": "Pennellata", "min": 0.3, "max": 4, "default": 1.8, "step": 0.1}, {"id": "relief", "label": "Rilievo", "default": 60}], "steps": [{"op": "oil", "radius": "$amount"}, {"op": "layer", "steps": [{"op": "emboss", "strength": 120, "depth": 0.15}], "blend": "overlay", "opacity": "$relief / 100"}], "group": "Tecniche di disegno"},
    {"id": "draw_stencil", "label": "Stencil", "params": [{"id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 115}, {"id": "dark", "label": "Colore", "type": "color", "default": "#111111"}, {"id": "light", "label": "Fondo", "type": "color", "default": "#f4f0e6"}], "steps": [{"op": "smooth", "radius": 1.5, "strength": 70}, {"op": "threshold", "level": "$level", "softness": 3, "dark": "$dark", "light": "$light"}], "group": "Tecniche di disegno"},
    {"id": "draw_stencil_red", "label": "Stencil rosso", "params": [{"id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 115}], "steps": [{"op": "smooth", "radius": 1.5, "strength": 70}, {"op": "threshold", "level": "$level", "softness": 3, "dark": "#b3131b", "light": "#f2e9dc"}, {"op": "texture", "kind": "concrete", "amount": 30, "blend": "multiply", "opacity": 0.6}], "group": "Tecniche di disegno"},
    {"id": "draw_stencil_blue", "label": "Stencil blu", "params": [{"id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 115}], "steps": [{"op": "smooth", "radius": 1.5, "strength": 70}, {"op": "threshold", "level": "$level", "softness": 3, "dark": "#0b2a6b", "light": "#e6eef8"}], "group": "Tecniche di disegno"},
    {"id": "draw_stencil_gold", "label": "Stencil oro", "params": [{"id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 115}], "steps": [{"op": "smooth", "radius": 1.5, "strength": 70}, {"op": "threshold", "level": "$level", "softness": 3, "dark": "#1a1408", "light": "#e0b44a"}], "group": "Tecniche di disegno"},
    {"id": "draw_stencil_pop", "label": "Stencil tricolore", "params": [{"id": "c1", "label": "Scuri", "type": "color", "default": "#0d1b2a"}, {"id": "c2", "label": "Medi", "type": "color", "default": "#d62828"}, {"id": "c3", "label": "Chiari", "type": "color", "default": "#f1e3c8"}], "steps": [{"op": "smooth", "radius": 1.5, "strength": 70}, {"op": "posterize", "levels": 3}, {"op": "gradient_map", "stops": [[0, "$c1"], [0.33, "$c1"], [0.34, "$c2"], [0.66, "$c2"], [0.67, "$c3"], [1, "$c3"]]}], "group": "Tecniche di disegno"},
    {"id": "draw_stencil_spray", "label": "Stencil spray", "params": [{"id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 120}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "smooth", "radius": 1.5, "strength": 70}, {"op": "threshold", "level": "$level", "softness": 3, "dark": "#141414", "light": "#ffffff"}, {"op": "turbulence", "amount": 0.25, "scale": 0.6}, {"op": "texture", "kind": "concrete", "scale": 1.5, "amount": 50, "blend": "multiply"}], "group": "Tecniche di disegno"},
    {"id": "draw_engraving", "label": "Incisione", "params": [{"id": "size", "label": "Tratteggio", "min": 0.3, "max": 3, "default": 0.7, "step": 0.1}, {"id": "angle", "label": "Angolo", "min": 0, "max": 180, "default": 35}], "steps": [{"op": "clarity", "amount": 40, "radius": 4}, {"op": "halftone", "mode": "lines", "size": "$size", "angle": "$angle", "ink": "#1d1a16", "paper": "#f3ead6"}], "group": "Tecniche di disegno"},
    {"id": "draw_emboss", "label": "Rilievo", "params": [{"id": "strength", "label": "Intensità", "min": 20, "max": 300, "default": 120}, {"id": "angle", "label": "Luce", "min": 0, "max": 360, "default": 135}], "steps": [{"op": "emboss", "strength": "$strength", "angle": "$angle", "gray": true}], "group": "Tecniche di disegno"},
    {"id": "draw_emboss_color", "label": "Rilievo colorato", "params": [{"id": "strength", "label": "Intensità", "min": 20, "max": 300, "default": 100}, {"id": "angle", "label": "Luce", "min": 0, "max": 360, "default": 135}], "steps": [{"op": "emboss", "strength": "$strength", "angle": "$angle", "gray": false}], "group": "Tecniche di disegno"},
    {"id": "draw_double_sketch", "label": "Doppio schizzo", "params": [{"id": "amount", "label": "Intensità", "default": 60}], "steps": [{"op": "sketch", "radius": 0.8, "darkness": "$amount"}, {"op": "layer", "steps": [{"op": "edges", "mode": "mono", "strength": 120, "smooth": 0.5}], "blend": "multiply", "opacity": 0.7}], "group": "Tecniche di disegno"},
    {"id": "draw_mirror_sketch", "label": "Schizzo specchiato", "params": [{"id": "mode", "label": "Lato", "type": "choice", "options": ["Sinistra", "Destra", "Alto", "Basso"], "default": 0}], "steps": [{"op": "mirror", "mode": {"pick": "$mode", "from": ["left", "right", "top", "bottom"]}}, {"op": "sketch", "radius": 1, "darkness": 50}], "group": "Tecniche di disegno"},
    {"id": "draw_blueprint", "label": "Progetto tecnico", "params": [{"id": "strength", "label": "Linee", "min": 50, "max": 300, "default": 160}], "steps": [{"op": "edges", "mode": "glow", "color": "#e6f0ff", "background": "#0b3d91", "strength": "$strength", "smooth": 0.4}, {"op": "pattern", "kind": "grid", "size": 5, "thickness": 8, "color": "#ffffff", "opacity": 0.12}], "group": "Tecniche di disegno"},
    {"id": "draw_chalkboard", "label": "Lavagna", "params": [{"id": "strength", "label": "Gesso", "min": 50, "max": 300, "default": 150}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "edges", "mode": "glow", "color": "#f2f2ea", "background": "#1f2a24", "strength": "$strength", "smooth": 0.5}, {"op": "texture", "kind": "noise", "scale": 0.3, "amount": 30, "blend": "overlay"}, {"op": "blur", "radius": 0.1}], "group": "Tecniche di disegno"},
    {"id": "draw_pastels", "label": "Pastelli a cera", "params": [{"id": "amount", "label": "Intensità", "default": 60}], "steps": [{"op": "oil", "radius": 1}, {"op": "adjust", "saturation": 30, "brightness": 10}, {"op": "layer", "steps": [{"op": "sketch", "radius": 1, "darkness": 40}], "blend": "multiply", "opacity": "$amount / 100"}, {"op": "texture", "kind": "canvas", "scale": 0.3, "amount": 40, "blend": "overlay"}], "group": "Tecniche di disegno"},
    {"id": "draw_pointillism", "label": "Puntinismo", "params": [{"id": "size", "label": "Punti", "min": 0.4, "max": 4, "default": 1, "step": 0.1}], "steps": [{"op": "adjust", "saturation": 40}, {"op": "pixelate", "size": "$size", "shape": "circle", "gap": 15, "background": "#f6f1e4"}], "group": "Tecniche di disegno"},
    {"id": "draw_tiles", "label": "Piastrelle", "params": [{"id": "size", "label": "Piastrelle", "min": 1, "max": 12, "default": 4, "step": 0.1}], "steps": [{"op": "pixelate", "size": "$size", "shape": "square", "gap": 12, "background": "#d8d4cc"}, {"op": "emboss", "strength": 40, "gray": false, "opacity": 0.5}], "group": "Tecniche di disegno"},
    {"id": "draw_dither_bw", "label": "Retino 1 bit", "params": [{"id": "size", "label": "Grana", "min": 0.1, "max": 2, "default": 0.3, "step": 0.1}], "steps": [{"op": "adjust", "contrast": 15}, {"op": "dither", "mode": "bayer", "levels": 2, "mono": true, "size": "$size"}], "group": "Tecniche di disegno"},
    {"id": "draw_dither_diffuse", "label": "Diffusione", "params": [{"id": "levels", "label": "Livelli", "min": 2, "max": 6, "default": 2}, {"id": "mono", "label": "Bianco e nero", "type": "toggle", "default": 1}], "steps": [{"op": "dither", "mode": "floyd", "levels": "$levels", "mono": "$mono"}], "group": "Tecniche di disegno"},
    {"id": "pop_mosaic", "label": "Mosaico", "params": [{"id": "size", "label": "Tessere", "min": 0.5, "max": 10, "default": 2.5, "step": 0.1}, {"id": "gap", "label": "Fuga", "min": 0, "max": 40, "default": 10}], "steps": [{"op": "pixelate", "size": "$size", "shape": "square", "gap": "$gap", "background": "#202024"}], "group": "Mosaici e vetrate"},
    {"id": "pop_dots", "label": "Punti colorati", "params": [{"id": "size", "label": "Punti", "min": 0.5, "max": 10, "default": 2, "step": 0.1}, {"id": "bg", "label": "Fondo", "type": "color", "default": "#0d0d12"}], "steps": [{"op": "adjust", "saturation": 25}, {"op": "pixelate", "size": "$size", "shape": "circle", "gap": 10, "background": "$bg"}], "group": "Mosaici e vetrate"},
    {"id": "pop_diamonds", "label": "Rombi", "params": [{"id": "size", "label": "Dimensione", "min": 0.5, "max": 10, "default": 2.5, "step": 0.1}], "steps": [{"op": "pixelate", "size": "$size", "shape": "diamond", "gap": 5, "background": "#111116"}], "group": "Mosaici e vetrate"},
    {"id": "pop_crystal", "label": "Cristalli", "params": [{"id": "size", "label": "Dimensione", "min": 0.5, "max": 12, "default": 3, "step": 0.1}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "crystallize", "size": "$size"}], "group": "Mosaici e vetrate"},
    {"id": "pop_stained_glass", "label": "Vetrata", "params": [{"id": "size", "label": "Dimensione", "min": 1, "max": 12, "default": 4, "step": 0.1}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "adjust", "saturation": 35, "contrast": 10}, {"op": "crystallize", "size": "$size", "border": 60, "borderColor": "#15110d"}, {"op": "glow", "threshold": 60, "radius": 1.5, "strength": 30}], "group": "Mosaici e vetrate"},
    {"id": "pop_color_grid", "label": "Griglia di colore", "params": [{"id": "size", "label": "Celle", "min": 2, "max": 30, "default": 8}, {"id": "hue", "label": "Variazione", "min": 10, "max": 180, "default": 120}, {"id": "amount", "label": "Intensità", "default": 60}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "cell_tint", "size": "$size", "hueRange": "$hue", "amount": "$amount"}], "group": "Mosaici e vetrate"}
  ]
}
