{
  "category": "fumetti",
  "effects": [
    {"id": "pop_comic_dots", "label": "Punti fumetto", "params": [{"id": "size", "label": "Punti", "min": 0.4, "max": 4, "default": 1, "step": 0.1}], "steps": [{"op": "adjust", "saturation": 40, "contrast": 15}, {"op": "halftone", "mode": "color", "size": "$size", "paper": "#ffffff"}, {"op": "edges", "mode": "overlay", "strength": 120, "smooth": 0.3}], "group": "Retini e pop"},
    {"id": "pop_halftone", "label": "Retino", "params": [{"id": "size", "label": "Dimensione", "min": 0.4, "max": 5, "default": 1.2, "step": 0.1}, {"id": "angle", "label": "Angolo", "min": 0, "max": 90, "default": 45}, {"id": "ink", "label": "Inchiostro", "type": "color", "default": "#111111"}, {"id": "paper", "label": "Carta", "type": "color", "default": "#f7f3e8"}], "steps": [{"op": "halftone", "mode": "mono", "size": "$size", "angle": "$angle", "ink": "$ink", "paper": "$paper"}], "group": "Retini e pop"},
    {"id": "pop_halftone_color", "label": "Retino a colori", "params": [{"id": "size", "label": "Dimensione", "min": 0.4, "max": 5, "default": 1, "step": 0.1}, {"id": "angle", "label": "Angolo", "min": 0, "max": 90, "default": 15}], "steps": [{"op": "halftone", "mode": "color", "size": "$size", "angle": "$angle", "paper": "#fffdf5"}], "group": "Retini e pop"},
    {"id": "pop_halftone_lines", "label": "Retino a linee", "params": [{"id": "size", "label": "Dimensione", "min": 0.4, "max": 5, "default": 1, "step": 0.1}, {"id": "angle", "label": "Angolo", "min": 0, "max": 180, "default": 30}], "steps": [{"op": "halftone", "mode": "lines", "size": "$size", "angle": "$angle", "ink": "#151515", "paper": "#f4efe2"}], "group": "Retini e pop"},
    {"id": "pop_sixties_comic", "label": "Fumetto anni '60", "params": [{"id": "size", "label": "Punti", "min": 0.5, "max": 4, "default": 1.4, "step": 0.1}], "steps": [{"op": "smooth", "radius": 1.5, "strength": 70}, {"op": "adjust", "saturation": 60, "contrast": 20}, {"op": "posterize", "levels": 4}, {"op": "layer", "steps": [{"op": "halftone", "mode": "mono", "size": "$size", "ink": "#000000", "paper": "#ffffff"}], "blend": "multiply", "opacity": 0.55}, {"op": "edges", "mode": "overlay", "strength": 160, "smooth": 0.3}], "group": "Retini e pop"},
    {"id": "pop_neon", "label": "Neon pop", "params": [{"id": "levels", "label": "Livelli", "min": 2, "max": 8, "default": 5}], "steps": [{"op": "smooth", "radius": 1, "strength": 50}, {"op": "posterize", "levels": "$levels"}, {"op": "gradient_map", "stops": [[0, "#0d0221"], [0.35, "#7b2cbf"], [0.7, "#ff2a6d"], [1, "#05d9e8"]]}], "group": "Retini e pop"},
    {"id": "draw_comic", "label": "Fumetto", "params": [{"id": "levels", "label": "Colori", "min": 3, "max": 12, "default": 6}, {"id": "lines", "label": "Linee", "min": 50, "max": 300, "default": 150}], "steps": [{"op": "smooth", "radius": 2, "strength": 70}, {"op": "posterize", "levels": "$levels"}, {"op": "edges", "mode": "overlay", "strength": "$lines", "smooth": 0.3}], "group": "Tratto"},
    {"id": "draw_cartoon", "label": "Cartoon", "params": [{"id": "amount", "label": "Semplificazione", "default": 70}, {"id": "lines", "label": "Linee", "min": 50, "max": 300, "default": 120}], "steps": [{"op": "smooth", "radius": 2, "strength": "$amount"}, {"op": "smooth", "radius": 1, "strength": "$amount"}, {"op": "adjust", "saturation": 25, "contrast": 10}, {"op": "posterize", "levels": 8}, {"op": "edges", "mode": "overlay", "strength": "$lines", "smooth": 0.4}], "group": "Tratto"},
    {"id": "draw_ink", "label": "Inchiostro", "params": [{"id": "strength", "label": "Tratto", "min": 50, "max": 300, "default": 140}, {"id": "smooth", "label": "Pulizia", "min": 0, "max": 2, "default": 0.4, "step": 0.1}], "steps": [{"op": "smooth", "radius": 1.2, "strength": 60}, {"op": "edges", "mode": "mono", "strength": "$strength", "smooth": "$smooth"}, {"op": "threshold", "level": 170, "softness": 20}], "group": "Tratto"},
    {"id": "draw_contours", "label": "Contorni", "params": [{"id": "strength", "label": "Intensità", "min": 30, "max": 300, "default": 100}], "steps": [{"op": "edges", "mode": "mono", "strength": "$strength", "smooth": 0.2}], "group": "Tratto"},
    {"id": "comic_color", "label": "Fumetto a colori", "group": "Tratto", "params": [{"id": "line", "label": "Spessore tratto", "default": 55}, {"id": "levels", "label": "Toni", "min": 3, "max": 8, "default": 4}], "steps": [{"op": "flat_regions", "levels": "$levels", "passes": 4, "saturation": 10}, {"op": "edges", "mode": "overlay", "strength": "$line + 20", "threshold": 10}], "tags": ["fumetto", "graphic novel"]},
    {"id": "comic_ink", "label": "China", "group": "Tratto", "params": [{"id": "line", "label": "Spessore tratto", "default": 60}, {"id": "level", "label": "Neri", "min": 60, "max": 200, "default": 115}], "steps": [{"op": "mono"}, {"op": "edges", "mode": "overlay", "strength": "$line + 30", "threshold": 8}, {"op": "threshold", "level": "$level", "softness": 6}], "tags": ["china", "noir", "manga"]},
    {"id": "comic_hatch", "label": "China tratteggiata", "group": "Tratto", "params": [{"id": "line", "label": "Spessore tratto", "min": 0.35, "max": 1.5, "default": 0.7}, {"id": "layers", "label": "Incroci", "min": 1, "max": 4, "default": 3}], "steps": [{"op": "hatching", "size": "$line", "layers": "$layers", "angle": 35, "contrast": 25}, {"op": "edges", "mode": "overlay", "strength": 65, "threshold": 10}], "tags": ["china", "tratteggio", "acquaforte"]},
    {"id": "comic_golden_age", "label": "Comics anni '50-'60", "group": "Grandi tradizioni", "params": [{"id": "dots", "label": "Retino", "min": 0.4, "max": 2, "default": 0.8}], "steps": [{"op": "flat_regions", "levels": 4, "passes": 3, "saturation": 45}, {"op": "layer", "steps": [{"op": "halftone", "mode": "color", "size": "$dots"}], "blend": "multiply", "opacity": 0.4}, {"op": "edges", "mode": "overlay", "strength": 85, "threshold": 12}, {"op": "fill", "color": "#f4e7c4", "blend": "multiply", "opacity": 0.35}], "tags": ["pop art", "ben-day"]},
    {"id": "comic_clear_line", "label": "Linea chiara", "group": "Grandi tradizioni", "params": [{"id": "line", "label": "Spessore tratto", "default": 45}, {"id": "levels", "label": "Toni", "min": 3, "max": 8, "default": 5}], "steps": [{"op": "flat_regions", "levels": "$levels", "passes": 3, "saturation": 20}, {"op": "adjust", "brightness": 5}, {"op": "edges", "mode": "overlay", "strength": "$line + 15", "threshold": 14}], "tags": ["bande dessinée", "europeo"]},
    {"id": "comic_webtoon", "label": "Webtoon", "group": "Carta e stampa", "params": [], "steps": [{"op": "skin_smooth", "amount": 60}, {"op": "flat_regions", "levels": 8, "passes": 2, "saturation": 15}, {"op": "adjust", "brightness": 8, "contrast": -5}, {"op": "glow", "threshold": 72, "radius": 4, "strength": 30}], "tags": ["webtoon", "digitale"]},
    {"id": "comic_pulp_paper", "label": "Carta giornale", "group": "Carta e stampa", "params": [], "steps": [{"op": "flat_regions", "levels": 5, "passes": 2, "saturation": -10}, {"op": "misregister", "inks": ["#00a0d8", "#e8308a", "#f5d800"], "offset": 0.35, "grain": 40, "paper": "#e9e2cf"}, {"op": "texture", "kind": "paper", "amount": 40, "blend": "multiply"}], "tags": ["pulp", "carta"]},
    {"id": "comic_noir_extreme", "label": "Noir estremo", "group": "Stili autoriali", "params": [{"id": "accent", "label": "Colore isolato", "type": "choice", "options": ["Rosso", "Giallo", "Blu"], "default": 0}], "steps": [{"op": "color_keep", "hue": {"pick": "$accent", "from": [0, 58, 215]}, "range": 20, "softness": 8, "outside": 0}, {"op": "curves", "rgb": [[0, 0], [100, 12], [140, 240], [255, 255]]}], "tags": ["sin city", "noir"]},
    {"id": "comic_multiverse", "label": "Multiverso pop", "group": "Stili autoriali", "params": [{"id": "dots", "label": "Retino", "min": 0.5, "max": 2.5, "default": 1.2}], "steps": [{"op": "flat_regions", "levels": 5, "passes": 2, "saturation": 30}, {"op": "adjust", "saturation": 45, "contrast": 20}, {"op": "layer", "steps": [{"op": "halftone", "mode": "mono", "size": "$dots"}], "blend": "multiply", "opacity": 0.35, "mask": {"type": "luma", "from": 0, "to": 45}}, {"op": "rgb_shift", "amount": 0.5}, {"op": "edges", "mode": "overlay", "strength": 70, "threshold": 12}], "tags": ["spider-verse", "aberrazione"]},
    {"id": "comic_cyber_manga", "label": "Cyber-manga", "group": "Stili autoriali", "params": [{"id": "amount", "label": "Intensità", "default": 85}], "steps": [{"op": "split_tone", "shadows": "#0a1a4a", "highlights": "#ff2a3a", "amount": "$amount * 0.7"}, {"op": "adjust", "contrast": 35}, {"op": "flat_regions", "levels": 5, "passes": 2, "saturation": 10}, {"op": "glow", "threshold": 60, "radius": 4, "strength": 55}, {"op": "edges", "mode": "overlay", "strength": 60, "threshold": 12}], "tags": ["akira", "anni 80"]},
    {"id": "comic_total_shadow", "label": "Ombre totali", "group": "Stili autoriali", "params": [{"id": "level", "label": "Ombre", "min": 40, "max": 160, "default": 95}], "steps": [{"op": "split_tone", "shadows": "#3a1810", "highlights": "#c88a4a", "amount": 50}, {"op": "layer", "steps": [{"op": "fill", "color": "#000000"}], "mask": {"type": "luma", "from": 0, "to": "$level / 2.55", "softness": 3}}, {"op": "edges", "mode": "overlay", "strength": 60, "threshold": 12}], "tags": ["mignola", "ombre"]},
    {"id": "comic_manga", "label": "Manga", "group": "Grandi tradizioni", "params": [{"id": "dots", "label": "Retino", "min": 0.4, "max": 2, "default": 0.75}, {"id": "black", "label": "Neri", "default": 22}, {"id": "white", "label": "Bianchi", "default": 70}], "steps": [{"op": "screentone", "size": "$dots", "black": "$black", "white": "$white", "contrast": 20}, {"op": "edges", "mode": "overlay", "strength": 60, "threshold": 10}], "tags": ["manga", "screentone"]},
    {"id": "comic_italian_chiaroscuro", "label": "Chiaroscuro all'italiana", "group": "Grandi tradizioni", "params": [{"id": "line", "label": "Spessore tratto", "min": 0.35, "max": 1.5, "default": 0.6}, {"id": "contrast", "label": "Contrasto", "default": 35}], "steps": [{"op": "hatching", "size": "$line", "layers": 4, "angle": 45, "contrast": "$contrast", "ink": "#121212", "paper": "#fbf8f0"}, {"op": "edges", "mode": "overlay", "strength": 70, "threshold": 10}], "tags": ["chiaroscuro", "tratteggio"]},
    {"id": "comic_speed", "label": "Linee cinetiche", "group": "Azione", "params": [{"id": "cx", "label": "Centro, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro, verticale", "min": 0, "max": 100, "default": 45}, {"id": "inner", "label": "Zona libera", "min": 10, "max": 85, "default": 42}, {"id": "count", "label": "Linee", "min": 40, "max": 320, "default": 150}, {"id": "levels", "label": "Toni", "min": 3, "max": 8, "default": 4}], "steps": [{"op": "flat_regions", "levels": "$levels", "passes": 4, "saturation": 15}, {"op": "edges", "mode": "overlay", "strength": 70, "threshold": 10}, {"op": "speed_lines", "cx": "$cx", "cy": "$cy", "inner": "$inner", "count": "$count", "spread": 40, "thickness": 0.8}], "tags": ["manga", "azione", "focus"]},
    {"id": "comic_manga_action", "label": "Manga d'azione", "group": "Azione", "params": [{"id": "cx", "label": "Centro, orizzontale", "min": 0, "max": 100, "default": 50}, {"id": "cy", "label": "Centro, verticale", "min": 0, "max": 100, "default": 45}, {"id": "inner", "label": "Zona libera", "min": 10, "max": 85, "default": 38}, {"id": "dots", "label": "Retino", "min": 0.4, "max": 2, "default": 0.75}], "steps": [{"op": "screentone", "size": "$dots", "black": 24, "white": 70, "contrast": 25}, {"op": "edges", "mode": "overlay", "strength": 65, "threshold": 10}, {"op": "speed_lines", "cx": "$cx", "cy": "$cy", "inner": "$inner", "count": 220, "spread": 30, "thickness": 0.6}], "tags": ["manga", "shonen", "azione"]}
  ]
}
