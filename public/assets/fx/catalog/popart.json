{
  "category": "popart",
  "effects": [
    { "id": "pop_grid4", "label": "Pop 4 riquadri",
      "params": [{ "id": "levels", "label": "Livelli", "min": 2, "max": 6, "default": 3 }],
      "steps": [
        { "op": "smooth", "radius": 1, "strength": 50 },
        { "op": "warhol", "rows": 2, "cols": 2, "levels": "$levels", "palettes": [
          ["#1b1b3a", "#e03a8c", "#ffd23f"], ["#0b3d2e", "#2ec4b6", "#f7f7a8"],
          ["#3a0ca3", "#f72585", "#4cc9f0"], ["#5f0f40", "#fb8b24", "#e9f5db"]] }
      ] },
    { "id": "pop_grid9", "label": "Pop 9 riquadri",
      "params": [{ "id": "levels", "label": "Livelli", "min": 2, "max": 6, "default": 3 }],
      "steps": [
        { "op": "smooth", "radius": 1, "strength": 50 },
        { "op": "warhol", "rows": 3, "cols": 3, "levels": "$levels", "palettes": [
          ["#1b1b3a", "#e03a8c", "#ffd23f"], ["#0b3d2e", "#2ec4b6", "#f7f7a8"], ["#3a0ca3", "#f72585", "#4cc9f0"],
          ["#5f0f40", "#fb8b24", "#e9f5db"], ["#03045e", "#00b4d8", "#caf0f8"], ["#370617", "#e85d04", "#ffba08"],
          ["#10002b", "#9d4edd", "#e0aaff"], ["#073b4c", "#06d6a0", "#ffd166"], ["#240046", "#ff006e", "#fbf8cc"]] }
      ] },
    { "id": "pop_four_tones", "label": "Quattro tinte",
      "params": [
        { "id": "c1", "label": "Colore 1", "type": "color", "default": "#ff006e" },
        { "id": "c2", "label": "Colore 2", "type": "color", "default": "#3a86ff" },
        { "id": "c3", "label": "Colore 3", "type": "color", "default": "#ffbe0b" },
        { "id": "c4", "label": "Colore 4", "type": "color", "default": "#06d6a0" }
      ],
      "steps": [{ "op": "warhol", "rows": 2, "cols": 2, "levels": 2, "palettes": [["#111111", "$c1"], ["#111111", "$c2"], ["#111111", "$c3"], ["#111111", "$c4"]] }] },
    { "id": "pop_two_tone", "label": "Pop bicolore",
      "params": [
        { "id": "dark", "label": "Inchiostro", "type": "color", "default": "#1d1d6b" },
        { "id": "light", "label": "Fondo", "type": "color", "default": "#ff4fa3" },
        { "id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 120 }
      ],
      "steps": [{ "op": "smooth", "radius": 1, "strength": 60 }, { "op": "threshold", "level": "$level", "softness": 4, "dark": "$dark", "light": "$light" }] },
    { "id": "pop_comic_dots", "label": "Punti fumetto",
      "params": [{ "id": "size", "label": "Punti", "min": 0.4, "max": 4, "default": 1, "step": 0.1 }],
      "steps": [
        { "op": "adjust", "saturation": 40, "contrast": 15 },
        { "op": "halftone", "mode": "color", "size": "$size", "paper": "#ffffff" },
        { "op": "edges", "mode": "overlay", "strength": 120, "smooth": 0.3 }
      ] },
    { "id": "pop_halftone", "label": "Retino",
      "params": [
        { "id": "size", "label": "Dimensione", "min": 0.4, "max": 5, "default": 1.2, "step": 0.1 },
        { "id": "angle", "label": "Angolo", "min": 0, "max": 90, "default": 45 },
        { "id": "ink", "label": "Inchiostro", "type": "color", "default": "#111111" },
        { "id": "paper", "label": "Carta", "type": "color", "default": "#f7f3e8" }
      ],
      "steps": [{ "op": "halftone", "mode": "mono", "size": "$size", "angle": "$angle", "ink": "$ink", "paper": "$paper" }] },
    { "id": "pop_halftone_color", "label": "Retino a colori",
      "params": [{ "id": "size", "label": "Dimensione", "min": 0.4, "max": 5, "default": 1, "step": 0.1 }, { "id": "angle", "label": "Angolo", "min": 0, "max": 90, "default": 15 }],
      "steps": [{ "op": "halftone", "mode": "color", "size": "$size", "angle": "$angle", "paper": "#fffdf5" }] },
    { "id": "pop_halftone_lines", "label": "Retino a linee",
      "params": [{ "id": "size", "label": "Dimensione", "min": 0.4, "max": 5, "default": 1, "step": 0.1 }, { "id": "angle", "label": "Angolo", "min": 0, "max": 180, "default": 30 }],
      "steps": [{ "op": "halftone", "mode": "lines", "size": "$size", "angle": "$angle", "ink": "#151515", "paper": "#f4efe2" }] },
    { "id": "pop_poster", "label": "Poster audace",
      "params": [{ "id": "levels", "label": "Livelli", "min": 2, "max": 8, "default": 4 }],
      "steps": [
        { "op": "smooth", "radius": 1.5, "strength": 60 },
        { "op": "adjust", "saturation": 40 },
        { "op": "posterize", "levels": "$levels" },
        { "op": "edges", "mode": "overlay", "strength": 100, "smooth": 0.3 }
      ] },
    { "id": "pop_color_grid", "label": "Griglia di colore",
      "params": [
        { "id": "size", "label": "Celle", "min": 2, "max": 30, "default": 8 },
        { "id": "hue", "label": "Variazione", "min": 10, "max": 180, "default": 120 },
        { "id": "amount", "label": "Intensità", "default": 60 },
        { "id": "seed", "label": "Variante", "max": 50, "default": 0 }
      ],
      "steps": [{ "op": "cell_tint", "size": "$size", "hueRange": "$hue", "amount": "$amount" }] },
    { "id": "pop_mosaic", "label": "Mosaico",
      "params": [{ "id": "size", "label": "Tessere", "min": 0.5, "max": 10, "default": 2.5, "step": 0.1 }, { "id": "gap", "label": "Fuga", "min": 0, "max": 40, "default": 10 }],
      "steps": [{ "op": "pixelate", "size": "$size", "shape": "square", "gap": "$gap", "background": "#202024" }] },
    { "id": "pop_dots", "label": "Punti colorati",
      "params": [{ "id": "size", "label": "Punti", "min": 0.5, "max": 10, "default": 2, "step": 0.1 }, { "id": "bg", "label": "Fondo", "type": "color", "default": "#0d0d12" }],
      "steps": [{ "op": "adjust", "saturation": 25 }, { "op": "pixelate", "size": "$size", "shape": "circle", "gap": 10, "background": "$bg" }] },
    { "id": "pop_diamonds", "label": "Rombi",
      "params": [{ "id": "size", "label": "Dimensione", "min": 0.5, "max": 10, "default": 2.5, "step": 0.1 }],
      "steps": [{ "op": "pixelate", "size": "$size", "shape": "diamond", "gap": 5, "background": "#111116" }] },
    { "id": "pop_crystal", "label": "Cristalli",
      "params": [{ "id": "size", "label": "Dimensione", "min": 0.5, "max": 12, "default": 3, "step": 0.1 }, { "id": "seed", "label": "Variante", "max": 50, "default": 0 }],
      "steps": [{ "op": "crystallize", "size": "$size" }] },
    { "id": "pop_stained_glass", "label": "Vetrata",
      "params": [{ "id": "size", "label": "Dimensione", "min": 1, "max": 12, "default": 4, "step": 0.1 }, { "id": "seed", "label": "Variante", "max": 50, "default": 0 }],
      "steps": [
        { "op": "adjust", "saturation": 35, "contrast": 10 },
        { "op": "crystallize", "size": "$size", "border": 60, "borderColor": "#15110d" },
        { "op": "glow", "threshold": 60, "radius": 1.5, "strength": 30 }
      ] },
    { "id": "pop_neon", "label": "Neon pop",
      "params": [{ "id": "levels", "label": "Livelli", "min": 2, "max": 8, "default": 5 }],
      "steps": [
        { "op": "smooth", "radius": 1, "strength": 50 },
        { "op": "posterize", "levels": "$levels" },
        { "op": "gradient_map", "stops": [[0, "#0d0221"], [0.35, "#7b2cbf"], [0.7, "#ff2a6d"], [1, "#05d9e8"]] }
      ] },
    { "id": "pop_sixties_comic", "label": "Fumetto anni '60",
      "params": [{ "id": "size", "label": "Punti", "min": 0.5, "max": 4, "default": 1.4, "step": 0.1 }],
      "steps": [
        { "op": "smooth", "radius": 1.5, "strength": 70 },
        { "op": "adjust", "saturation": 60, "contrast": 20 },
        { "op": "posterize", "levels": 4 },
        { "op": "layer", "steps": [{ "op": "halftone", "mode": "mono", "size": "$size", "ink": "#000000", "paper": "#ffffff" }], "blend": "multiply", "opacity": 0.55 },
        { "op": "edges", "mode": "overlay", "strength": 160, "smooth": 0.3 }
      ] },
    { "id": "pop_screenprint", "label": "Serigrafia",
      "params": [
        { "id": "ink", "label": "Inchiostro", "type": "color", "default": "#e4003a" },
        { "id": "paper", "label": "Carta", "type": "color", "default": "#f5ecd7" },
        { "id": "offset", "label": "Fuori registro", "min": 0, "max": 3, "default": 0.6, "step": 0.1 }
      ],
      "steps": [
        { "op": "smooth", "radius": 1, "strength": 60 },
        { "op": "threshold", "level": 120, "softness": 6, "dark": "$ink", "light": "$paper" },
        { "op": "rgb_shift", "amount": "$offset", "angle": 30 },
        { "op": "texture", "kind": "paper", "amount": 30, "blend": "multiply", "opacity": 0.6 }
      ] }
  ]
}
