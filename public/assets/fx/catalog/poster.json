    {"id": "poster_vintage", "label": "Poster vintage", "tags": ["poster", "serigrafia", "anni 70"], "params": [{"id": "colors", "label": "Colori", "min": 3, "max": 8, "default": 5}, {"id": "simplify", "label": "Semplificazione", "min": 0, "max": 10, "default": 3}, {"id": "tone", "label": "Sfumature", "min": 0, "max": 40, "default": 15}, {"id": "grain", "label": "Grana", "min": 0, "max": 40, "default": 14}, {"id": "aged", "label": "Carta invecchiata", "default": 40}, {"id": "margin", "label": "Margine", "type": "toggle", "default": 1}, {"id": "seed", "label": "Variante", "max": 50, "default": 0}], "steps": [{"op": "blur", "radius": "$simplify * 0.12", "if": "$simplify"}, {"op": "palette_quantize", "colors": "$colors", "tone": "$tone", "aged": "$aged"}, {"op": "fill", "color": "rgb(246 - $aged * 0.14, 238 - $aged * 0.22, 218 - $aged * 0.4)", "blend": "multiply", "opacity": 0.5}, {"op": "grain", "amount": "$grain * 1.6", "size": 0.08}, {"op": "fibers", "amount": 100, "aged": "$aged"}, {"op": "mat", "size": 5, "color": "rgb(246 - $aged * 0.14, 238 - $aged * 0.22, 218 - $aged * 0.4)", "if": "$margin"}], "group": "Classici"},
