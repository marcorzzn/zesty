{
  "category": "disegno",
  "effects": [
    { "id": "draw_pencil", "label": "Matita",
      "params": [
        { "id": "radius", "label": "Tratto", "min": 0.3, "max": 3, "default": 1, "step": 0.1 },
        { "id": "darkness", "label": "Intensità", "default": 50 }
      ],
      "steps": [{ "op": "sketch", "radius": "$radius", "darkness": "$darkness" }] },
    { "id": "draw_color_pencil", "label": "Matite colorate",
      "params": [
        { "id": "radius", "label": "Tratto", "min": 0.3, "max": 3, "default": 1, "step": 0.1 },
        { "id": "darkness", "label": "Intensità", "default": 45 }
      ],
      "steps": [{ "op": "adjust", "saturation": 30 }, { "op": "sketch", "radius": "$radius", "darkness": "$darkness", "colored": true }] },
    { "id": "draw_charcoal", "label": "Carboncino",
      "params": [{ "id": "amount", "label": "Intensità", "default": 70 }, { "id": "seed", "label": "Variante", "max": 50, "default": 0 }],
      "steps": [
        { "op": "sketch", "radius": 2, "darkness": "$amount" },
        { "op": "adjust", "contrast": 25 },
        { "op": "texture", "kind": "paper", "scale": 0.6, "amount": 60, "blend": "multiply" }
      ] },
    { "id": "draw_ink", "label": "Inchiostro",
      "params": [{ "id": "strength", "label": "Tratto", "min": 50, "max": 300, "default": 140 }, { "id": "smooth", "label": "Pulizia", "min": 0, "max": 2, "default": 0.4, "step": 0.1 }],
      "steps": [
        { "op": "smooth", "radius": 1.2, "strength": 60 },
        { "op": "edges", "mode": "mono", "strength": "$strength", "smooth": "$smooth" },
        { "op": "threshold", "level": 170, "softness": 20 }
      ] },
    { "id": "draw_contours", "label": "Contorni",
      "params": [{ "id": "strength", "label": "Intensità", "min": 30, "max": 300, "default": 100 }],
      "steps": [{ "op": "edges", "mode": "mono", "strength": "$strength", "smooth": 0.2 }] },
    { "id": "draw_color_contours", "label": "Contorni colorati",
      "params": [{ "id": "strength", "label": "Intensità", "min": 30, "max": 300, "default": 140 }],
      "steps": [{ "op": "adjust", "saturation": 40 }, { "op": "edges", "mode": "color", "strength": "$strength", "smooth": 0.2 }] },
    { "id": "draw_neon_edges", "label": "Contorni neon",
      "params": [{ "id": "strength", "label": "Intensità", "min": 50, "max": 300, "default": 180 }, { "id": "glow", "label": "Bagliore", "default": 70 }],
      "steps": [
        { "op": "adjust", "saturation": 80 },
        { "op": "edges", "mode": "glow", "keepColor": true, "strength": "$strength", "smooth": 0.3 },
        { "op": "glow", "threshold": 15, "radius": 1.5, "strength": "$glow" }
      ] },
    { "id": "draw_comic", "label": "Fumetto",
      "params": [{ "id": "levels", "label": "Colori", "min": 3, "max": 12, "default": 6 }, { "id": "lines", "label": "Linee", "min": 50, "max": 300, "default": 150 }],
      "steps": [
        { "op": "smooth", "radius": 2, "strength": 70 },
        { "op": "posterize", "levels": "$levels" },
        { "op": "edges", "mode": "overlay", "strength": "$lines", "smooth": 0.3 }
      ] },
    { "id": "draw_cartoon", "label": "Cartoon",
      "params": [{ "id": "amount", "label": "Semplificazione", "default": 70 }, { "id": "lines", "label": "Linee", "min": 50, "max": 300, "default": 120 }],
      "steps": [
        { "op": "smooth", "radius": 2, "strength": "$amount" },
        { "op": "smooth", "radius": 1, "strength": "$amount" },
        { "op": "adjust", "saturation": 25, "contrast": 10 },
        { "op": "posterize", "levels": 8 },
        { "op": "edges", "mode": "overlay", "strength": "$lines", "smooth": 0.4 }
      ] },
    { "id": "draw_watercolor", "label": "Acquerello",
      "params": [{ "id": "amount", "label": "Intensità", "default": 70 }, { "id": "seed", "label": "Variante", "max": 50, "default": 0 }],
      "steps": [
        { "op": "smooth", "radius": 2, "strength": 70 },
        { "op": "oil", "radius": "0.5 + $amount * 0.012" },
        { "op": "turbulence", "amount": 0.4, "scale": 4 },
        { "op": "adjust", "saturation": 15, "brightness": 8 },
        { "op": "edges", "mode": "overlay", "strength": 60, "smooth": 0.6, "opacity": 0.5 },
        { "op": "texture", "kind": "paper", "scale": 0.8, "amount": 45, "blend": "multiply" }
      ] },
    { "id": "draw_oil", "label": "Pittura a olio",
      "params": [{ "id": "amount", "label": "Pennellata", "min": 0.3, "max": 4, "default": 1.4, "step": 0.1 }],
      "steps": [
        { "op": "oil", "radius": "$amount" },
        { "op": "adjust", "saturation": 15 },
        { "op": "texture", "kind": "canvas", "scale": 0.4, "amount": 35, "blend": "overlay" },
        { "op": "sharpen", "amount": 50, "radius": 0.3 }
      ] },
    { "id": "draw_impasto", "label": "Impasto",
      "params": [{ "id": "amount", "label": "Pennellata", "min": 0.3, "max": 4, "default": 1.8, "step": 0.1 }, { "id": "relief", "label": "Rilievo", "default": 60 }],
      "steps": [
        { "op": "oil", "radius": "$amount" },
        { "op": "layer", "steps": [{ "op": "emboss", "strength": 120, "depth": 0.15 }], "blend": "overlay", "opacity": "$relief / 100" }
      ] },
    { "id": "draw_stencil", "label": "Stencil",
      "params": [
        { "id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 115 },
        { "id": "dark", "label": "Colore", "type": "color", "default": "#111111" },
        { "id": "light", "label": "Fondo", "type": "color", "default": "#f4f0e6" }
      ],
      "steps": [{ "op": "smooth", "radius": 1.5, "strength": 70 }, { "op": "threshold", "level": "$level", "softness": 3, "dark": "$dark", "light": "$light" }] },
    { "id": "draw_stencil_red", "label": "Stencil rosso",
      "params": [{ "id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 115 }],
      "steps": [{ "op": "smooth", "radius": 1.5, "strength": 70 }, { "op": "threshold", "level": "$level", "softness": 3, "dark": "#b3131b", "light": "#f2e9dc" }, { "op": "texture", "kind": "concrete", "amount": 30, "blend": "multiply", "opacity": 0.6 }] },
    { "id": "draw_stencil_blue", "label": "Stencil blu",
      "params": [{ "id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 115 }],
      "steps": [{ "op": "smooth", "radius": 1.5, "strength": 70 }, { "op": "threshold", "level": "$level", "softness": 3, "dark": "#0b2a6b", "light": "#e6eef8" }] },
    { "id": "draw_stencil_gold", "label": "Stencil oro",
      "params": [{ "id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 115 }],
      "steps": [{ "op": "smooth", "radius": 1.5, "strength": 70 }, { "op": "threshold", "level": "$level", "softness": 3, "dark": "#1a1408", "light": "#e0b44a" }] },
    { "id": "draw_stencil_pop", "label": "Stencil tricolore",
      "params": [{ "id": "c1", "label": "Scuri", "type": "color", "default": "#0d1b2a" }, { "id": "c2", "label": "Medi", "type": "color", "default": "#d62828" }, { "id": "c3", "label": "Chiari", "type": "color", "default": "#f1e3c8" }],
      "steps": [{ "op": "smooth", "radius": 1.5, "strength": 70 }, { "op": "posterize", "levels": 3 }, { "op": "gradient_map", "stops": [[0, "$c1"], [0.33, "$c1"], [0.34, "$c2"], [0.66, "$c2"], [0.67, "$c3"], [1, "$c3"]] }] },
    { "id": "draw_stencil_spray", "label": "Stencil spray",
      "params": [{ "id": "level", "label": "Soglia", "min": 30, "max": 220, "default": 120 }, { "id": "seed", "label": "Variante", "max": 50, "default": 0 }],
      "steps": [
        { "op": "smooth", "radius": 1.5, "strength": 70 },
        { "op": "threshold", "level": "$level", "softness": 3, "dark": "#141414", "light": "#ffffff" },
        { "op": "turbulence", "amount": 0.25, "scale": 0.6 },
        { "op": "texture", "kind": "concrete", "scale": 1.5, "amount": 50, "blend": "multiply" }
      ] },
    { "id": "draw_engraving", "label": "Incisione",
      "params": [{ "id": "size", "label": "Tratteggio", "min": 0.3, "max": 3, "default": 0.7, "step": 0.1 }, { "id": "angle", "label": "Angolo", "min": 0, "max": 180, "default": 35 }],
      "steps": [{ "op": "clarity", "amount": 40, "radius": 4 }, { "op": "halftone", "mode": "lines", "size": "$size", "angle": "$angle", "ink": "#1d1a16", "paper": "#f3ead6" }] },
    { "id": "draw_emboss", "label": "Rilievo",
      "params": [{ "id": "strength", "label": "Intensità", "min": 20, "max": 300, "default": 120 }, { "id": "angle", "label": "Luce", "min": 0, "max": 360, "default": 135 }],
      "steps": [{ "op": "emboss", "strength": "$strength", "angle": "$angle", "gray": true }] },
    { "id": "draw_emboss_color", "label": "Rilievo colorato",
      "params": [{ "id": "strength", "label": "Intensità", "min": 20, "max": 300, "default": 100 }, { "id": "angle", "label": "Luce", "min": 0, "max": 360, "default": 135 }],
      "steps": [{ "op": "emboss", "strength": "$strength", "angle": "$angle", "gray": false }] },
    { "id": "draw_double_sketch", "label": "Doppio schizzo",
      "params": [{ "id": "amount", "label": "Intensità", "default": 60 }],
      "steps": [
        { "op": "sketch", "radius": 0.8, "darkness": "$amount" },
        { "op": "layer", "steps": [{ "op": "edges", "mode": "mono", "strength": 120, "smooth": 0.5 }], "blend": "multiply", "opacity": 0.7 }
      ] },
    { "id": "draw_mirror_sketch", "label": "Schizzo specchiato",
      "params": [{ "id": "mode", "label": "Lato", "type": "choice", "options": ["Sinistra", "Destra", "Alto", "Basso"], "default": 0 }],
      "steps": [{ "op": "mirror", "mode": { "pick": "$mode", "from": ["left", "right", "top", "bottom"] } }, { "op": "sketch", "radius": 1, "darkness": 50 }] },
    { "id": "draw_blueprint", "label": "Progetto tecnico",
      "params": [{ "id": "strength", "label": "Linee", "min": 50, "max": 300, "default": 160 }],
      "steps": [
        { "op": "edges", "mode": "glow", "color": "#e6f0ff", "background": "#0b3d91", "strength": "$strength", "smooth": 0.4 },
        { "op": "pattern", "kind": "grid", "size": 5, "thickness": 8, "color": "#ffffff", "opacity": 0.12 }
      ] },
    { "id": "draw_chalkboard", "label": "Lavagna",
      "params": [{ "id": "strength", "label": "Gesso", "min": 50, "max": 300, "default": 150 }, { "id": "seed", "label": "Variante", "max": 50, "default": 0 }],
      "steps": [
        { "op": "edges", "mode": "glow", "color": "#f2f2ea", "background": "#1f2a24", "strength": "$strength", "smooth": 0.5 },
        { "op": "texture", "kind": "noise", "scale": 0.3, "amount": 30, "blend": "overlay" },
        { "op": "blur", "radius": 0.1 }
      ] },
    { "id": "draw_pastels", "label": "Pastelli a cera",
      "params": [{ "id": "amount", "label": "Intensità", "default": 60 }],
      "steps": [
        { "op": "oil", "radius": 1 },
        { "op": "adjust", "saturation": 30, "brightness": 10 },
        { "op": "layer", "steps": [{ "op": "sketch", "radius": 1, "darkness": 40 }], "blend": "multiply", "opacity": "$amount / 100" },
        { "op": "texture", "kind": "canvas", "scale": 0.3, "amount": 40, "blend": "overlay" }
      ] },
    { "id": "draw_pointillism", "label": "Puntinismo",
      "params": [{ "id": "size", "label": "Punti", "min": 0.4, "max": 4, "default": 1, "step": 0.1 }],
      "steps": [{ "op": "adjust", "saturation": 40 }, { "op": "pixelate", "size": "$size", "shape": "circle", "gap": 15, "background": "#f6f1e4" }] },
    { "id": "draw_tiles", "label": "Piastrelle",
      "params": [{ "id": "size", "label": "Piastrelle", "min": 1, "max": 12, "default": 4, "step": 0.1 }],
      "steps": [{ "op": "pixelate", "size": "$size", "shape": "square", "gap": 12, "background": "#d8d4cc" }, { "op": "emboss", "strength": 40, "gray": false, "opacity": 0.5 }] },
    { "id": "draw_dither_bw", "label": "Retino 1 bit",
      "params": [{ "id": "size", "label": "Grana", "min": 0.1, "max": 2, "default": 0.3, "step": 0.1 }],
      "steps": [{ "op": "adjust", "contrast": 15 }, { "op": "dither", "mode": "bayer", "levels": 2, "mono": true, "size": "$size" }] },
    { "id": "draw_dither_diffuse", "label": "Diffusione",
      "params": [{ "id": "levels", "label": "Livelli", "min": 2, "max": 6, "default": 2 }, { "id": "mono", "label": "Bianco e nero", "type": "toggle", "default": 1 }],
      "steps": [{ "op": "dither", "mode": "floyd", "levels": "$levels", "mono": "$mono" }] }
  ]
}
